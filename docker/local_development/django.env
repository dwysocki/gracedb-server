# Required: set this to some value; should be long (~50 chars) and random
DJANGO_SECRET_KEY=temp_secret_key
DJANGO_PRIMARY_FQDN=gracedb

# Override these values if you want
DJANGO_USERNAME=test_user
DJANGO_USER_PASSWORD=test_password

# Set the settings module for the local container.
# If this is not set correctly the container will launch
# but http requests won't work and shibboleth will be enabled
DJANGO_SETTINGS_MODULE=config.settings.container.local

# Required: some temp db username/password/names. I don't think this matters
# with the sqlite implementation but okay.
DJANGO_DB_USER=gracedb_local
DJANGO_DB_PASSWORD=password_local
DJANGO_DB_NAME=gracedb_testing

# Required: igwn-alert parameters:
ENABLE_IGWN_OVERSEER=false
IGWN_ALERT_SERVER=kafka
IGWN_ALERT_OVERSEER_PORT=9092
IGWN_ALERT_USER=${DJANGO_USERNAME}
IGWN_ALERT_PASSWORD=${DJANGO_USER_PASSWORD}
IGWN_ALERT_GROUP=gracedb_local
IGWN_ALERT_FLUSH_INTERVAL=500

# This doesn't matter in testing
DJANGO_TWILIO_ACCOUNT_SID=fake
DJANGO_TWILIO_AUTH_TOKEN=fake
DJANGO_ALERT_EMAIL_FROM=fake
AWS_SES_ACCESS_KEY_ID=fake
AWS_SES_SECRET_ACCESS_KEY=fake
DJANGO_ENABLE_REDIS_QUEUE=false
DJANGO_ENABLE_LOCAL_REDIS=false

# Gunicorn Tweaks
GUNICORN_PRELOAD_APP=False
DJANGO_DOCKER_MEMCACHED_SECONDS=0

# SciToken issuer settings for local development
# The local issuer runs in docker as gracedb-scitokens-issuer
SCITOKEN_ISSUERS=https://gracedb-scitokens-issuer:8443
SCITOKEN_AUDIENCES=http://localhost,ANY
