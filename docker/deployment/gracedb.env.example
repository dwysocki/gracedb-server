# =============================================================================
# GraceDB Deployment Environment Configuration
# =============================================================================
# Copy this file to gracedb.env and configure all values before deployment.
# DO NOT commit gracedb.env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# HOST-SPECIFIC SETTINGS (must change per deployment)
# -----------------------------------------------------------------------------

# The fully qualified domain name for this GraceDB instance
# Example: gracedb.ligo.org, gracedb-test.ligo.org
# TODO: Determine best way to auto-populate this from the host environment
DJANGO_PRIMARY_FQDN=your-hostname.ligo.org

# Django secret key - MUST be unique per deployment
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_UNIQUE_SECRET_KEY

# Instance identifier (displayed in UI, used for logging)
CONFIG_NAME="GraceDB VM"

# Instance title displayed on the home page
#INSTANCE_TITLE=MDC/LLPIC Validation Instance

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (shared between gracedb and postgres services)
# -----------------------------------------------------------------------------

# PostgreSQL database name
POSTGRES_DB=gracedb

# PostgreSQL username
POSTGRES_USER=gracedb_user

# PostgreSQL password - use a strong, unique password
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# PostgreSQL host - must match the service name in docker-compose.yml
POSTGRES_HOST=postgres

# Django database settings (should match PostgreSQL settings above)
DJANGO_DB_NAME=gracedb
DJANGO_DB_USER=gracedb_user
DJANGO_DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# DJANGO SETTINGS
# -----------------------------------------------------------------------------

# Django settings module for proxy-authenticated deployments
DJANGO_SETTINGS_MODULE=config.settings.container.vm-proxy

# Initial admin user credentials (used during first-time setup)
DJANGO_USERNAME=admin
DJANGO_USER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# SHIBBOLETH CONFIGURATION
# -----------------------------------------------------------------------------

# HTTP header name for group membership (isMemberOf attribute)
# Apache mod_shib typically forwards this as HTTP_SHIB_ISMEMBEROF
# Only needed if your IdP/SP configuration uses a different header name
#SHIB_GROUPS_HEADER=HTTP_SHIB_ISMEMBEROF

# -----------------------------------------------------------------------------
# IGWN ALERT CONFIGURATION
# -----------------------------------------------------------------------------

# Enable/disable IGWN Alert overseer
ENABLE_IGWN_OVERSEER=false

# IGWN Alert server URL
IGWN_ALERT_SERVER=kafka://kafka.scimma.org/

# IGWN Alert port
IGWN_ALERT_OVERSEER_PORT=9092

# IGWN Alert credentials
IGWN_ALERT_USER=your-igwn-user
IGWN_ALERT_PASSWORD=CHANGE_ME_IGWN_PASSWORD

# IGWN Alert group identifier
IGWN_ALERT_GROUP=gracedb-vm

# Alert flush interval in milliseconds
IGWN_ALERT_FLUSH_INTERVAL=500

# Enable/disable XMPP alerts
SEND_LVALERT_XMPP_ALERTS=True

# -----------------------------------------------------------------------------
# NOTIFICATION SERVICES (optional)
# -----------------------------------------------------------------------------

# Twilio configuration for SMS notifications
DJANGO_TWILIO_ACCOUNT_SID=
DJANGO_TWILIO_AUTH_TOKEN=

# Email configuration
DJANGO_ALERT_EMAIL_FROM=gracedb@ligo.org
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# REDIS QUEUE CONFIGURATION (optional)
# -----------------------------------------------------------------------------

# Enable Redis-based task queue
DJANGO_ENABLE_REDIS_QUEUE=false

# Enable local Redis container (set to true if not using external Redis)
DJANGO_ENABLE_LOCAL_REDIS=false

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING (optional)
# -----------------------------------------------------------------------------

# Gunicorn preload setting (set to True for production)
GUNICORN_PRELOAD_APP=True

# Memcached timeout in seconds (0 to disable)
DJANGO_DOCKER_MEMCACHED_SECONDS=300

# -----------------------------------------------------------------------------
# SERVICE PORT (optional)
# -----------------------------------------------------------------------------

# Host port to expose (default: 80)
# SERVICE_PORT=80

# -----------------------------------------------------------------------------
# IMAGE TAG (optional)
# -----------------------------------------------------------------------------

# Docker image tag to use (default: latest)
# GRACEDB_TAG=latest
